# Supabase - get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# REQUIRED for the public Emergency Card scan page (/emergency/[token])
# Without this, anyone scanning the QR code gets a 500 error.
# Get it from: Supabase Dashboard > Settings > API > service_role (secret key)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Gemini AI (Milestone 7) — server-side only, never expose to browser
# Get a free key at https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=AIza...

# Face service (Milestone 4) — server-side only, never expose to browser
# FACE_SERVICE_URL=http://localhost:8000          # local dev
# FACE_SERVICE_URL=https://your-service.onrender.com  # production
# FACE_SERVICE_SECRET=same-value-as-SERVICE_SECRET-in-face-service/.env
