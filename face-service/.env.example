# Memory Companion — Face Service environment variables
# Copy to .env and fill in real values before running locally.

# Supabase project URL (e.g. https://xxxx.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Supabase SERVICE ROLE key — bypasses RLS. Server-side only, never expose to browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Shared secret between this service and the Next.js backend.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Must match FACE_SERVICE_SECRET in the Next.js .env.local
SERVICE_SECRET=change-me-to-a-long-random-string

# Comma-separated or single origin the Next.js app is served from.
# localhost:3000 is always allowed in addition to this.
ALLOWED_ORIGIN=https://your-app.vercel.app

# Port (Render sets this automatically; 8000 for local)
PORT=8000
